<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="app.terra.test.sharereceiver">
    <application android:label="Terra File Check" android:debuggable="true" android:allowBackup="false">
        <activity android:name=".ReceiveActivity" android:label="Terra File Check" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="application/pdf"/>
                <data android:mimeType="multipart/related"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
